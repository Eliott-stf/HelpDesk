PORT=3000
MONGODB_URI=mongodb://localhost:27017
DB_NAME=helpdesk
CORS_ORIGIN=http://localhost:5173

# Secrets JWT (32 caractères minimum, différents l'un de l'autre).
# En développement, des valeurs par défaut sont utilisées si ces lignes sont vides.
# En production, elles sont obligatoires. Pour en générer un :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Durées en secondes (15 min et 7 jours par défaut)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# true uniquement derrière HTTPS
COOKIE_SECURE=false
